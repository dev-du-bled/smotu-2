{
  "name": "smotu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && npm run d1:migrate:remote && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "d1:migrate:local": "wrangler d1 migrations apply smotu-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply smotu-db --remote",
    "check:words": "bun scripts/check-words.ts"
  },
  "dependencies": {
    "@better-auth/i18n": "^1.7.14",
    "better-auth": "^1.7.14",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.4",
    "posthog-js": "^1.444.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "4.107.1"
  }
}
